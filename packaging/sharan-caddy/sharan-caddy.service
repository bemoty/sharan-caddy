[Unit]
Description=Caddy web server built for use with Sharan
Documentation=https://caddyserver.com/docs/
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=sharan-caddy
Group=sharan-caddy
ExecStart=/usr/bin/sharan-caddy run --environ --config /etc/sharan-caddy/Caddyfile
ExecReload=/usr/bin/sharan-caddy reload --config /etc/sharan-caddy/Caddyfile --force
TimeoutStopSec=5s
Restart=on-failure
# Each proxied connection holds file descriptors open; default ulimit is far too low for a reverse proxy.
LimitNOFILE=1048576
LimitNPROC=512
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sharan-caddy

[Install]
WantedBy=multi-user.target
