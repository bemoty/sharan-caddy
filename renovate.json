{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchFileNames": ["modules.json"],
      "groupName": "caddy modules",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^modules\\.json$"],
      "matchStrings": [
        "\"import\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^\\.github/workflows/build\\.yml$"],
      "matchStrings": [
        "go install (?<depName>github\\.com/[^/\\s]+/[^/\\s]+(?:/v\\d+)?)(?:/\\S+)?@(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "go"
    }
  ]
}
